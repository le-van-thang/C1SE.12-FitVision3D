# ==========================================
# CẤU HÌNH CỔNG & MÔI TRƯỜNG
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# ==========================================
# CƠ SỞ DỮ LIỆU (POSTGRESQL / MYSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=fitvision3d

# ==========================================
# XÁC THỰC & BẢO MẬT TOKEN (JWT & COOKIE)
# ==========================================
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d

# ==========================================
# GOOGLE OAUTH 2.0 (ĐĂNG NHẬP VỚI GOOGLE)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==========================================
# TÍCH HỢP AI-TAILOR 3D WORKER
# ==========================================
AI_TAILOR_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_API_KEY=fitvision_internal_ai_secret_key_2026

# ==========================================
# DỊCH VỤ EMAIL (GỬI OTP / XÁC THỰC)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@fitvision3d.com
SMTP_PASS=your_app_password
EMAIL_FROM="FitVision3D Support <no-reply@fitvision3d.com>"

# ==========================================
# GOOGLE GEMINI AI (Trợ lý AI Khách/Shop/Admin)
# ==========================================
# Lấy tại: aistudio.google.com -> Get API key (để trống thì bot AI tạm tắt)
GEMINI_API_KEY=

# ==========================================
# PAYPAL MARKETPLACE (ORDERS V2 + PAYOUTS V1)
# ==========================================
# Chế độ: sandbox (test miễn phí bằng Sandbox Accounts) hoặc live (tiền thật)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_business_client_id
PAYPAL_CLIENT_SECRET=your_paypal_business_client_secret
PAYPAL_WEBHOOK_ID=

# Quy chuẩn tỷ giá, hoa hồng sàn & thời hạn giữ tiền đối soát (Escrow Hold)
PAYPAL_VND_RATE=25400
PAYPAL_PLATFORM_FEE_RATE=0.05
# Đặt 0 để test giải ngân ngay sau khi đơn completed; thực tế vận hành khuyên đặt 3 (72 giờ)
PAYPAL_HOLD_DAYS=0
