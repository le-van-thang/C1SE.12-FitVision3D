# ==============================================================================
# Dockerfile: Frontend (React 19 + TypeScript + Vite)
# Cài đặt đầy đủ các native binaries của Vite v8 cho Linux x64 (rolldown & lightningcss)
# ==============================================================================

# Stage 1: Build stage
FROM node:22-slim AS builder

WORKDIR /app

# Copy package descriptors
COPY package*.json ./

# Cài dependencies kèm trực tiếp native bindings linux x64 của Vite Rolldown và LightningCSS
RUN npm install && npm install --no-save @rolldown/binding-linux-x64-gnu lightningcss-linux-x64-gnu

# Copy source code
COPY . .

# Build Vite dist
RUN npm run build

# Stage 2: Production serve with Nginx
FROM nginx:alpine

# Copy custom nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
