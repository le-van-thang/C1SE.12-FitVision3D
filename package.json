{
  "name": "fitvision-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"vite --port 5173 --host\" \"cd backend && npm run dev\"",
    "dev:full": "concurrently -n \"FRONTEND,BACKEND,AI-CORE\" -c \"cyan,magenta,yellow\" \"vite --port 5173 --host\" \"cd backend && npm run dev\" \"python app.py\"",
    "start": "npm run dev:all",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "i18n:check": "node scripts/i18n-check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.186.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
