# ==============================================================================
# Dockerfile: Backend Service (Express + TypeScript + JWT + PostgreSQL)
# ==============================================================================

FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY backend/package*.json ./
RUN npm ci

# Copy backend source
COPY backend/ ./

# Expose backend port
EXPOSE 5000

# Run development or production
CMD ["npm", "run", "dev"]

